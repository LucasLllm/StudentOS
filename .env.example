# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# --- Database --------------------------------------------------------------
# Matches docker-compose.yml. `pnpm db:up` starts it.
DATABASE_URL=postgres://studentos:studentos@localhost:5432/studentos

# --- URLs ------------------------------------------------------------------
# API_BASE_URL must match the origin of your Google redirect URI exactly.
API_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:5173

# Read by the Vite build (must be prefixed VITE_ to be exposed to the client).
VITE_API_BASE_URL=http://localhost:3000

# --- Secrets ---------------------------------------------------------------
# Generate both with: openssl rand -base64 32

# Signs session tokens.
AUTH_SECRET=

# Encrypts students' API keys at rest (AES-256-GCM, so exactly 32 bytes).
#
# LOSING THIS IS UNRECOVERABLE. Every stored credential becomes permanently
# undecryptable and every student has to re-enter their key. Back it up
# somewhere that is not the machine it runs on.
MASTER_ENCRYPTION_KEY=

# --- Google OAuth ----------------------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials
#   -> OAuth 2.0 Client ID, type "Web application"
#
# Authorised redirect URI:
#   http://localhost:3000/api/auth/callback/google
#
# Enable these APIs on the project when you implement the integrations:
#   Google Classroom API, Google Drive API, Gmail API
#
# Scopes are NOT configured here -- they are requested per feature. See
# packages/agent/src/tools/google/scopes.ts, and read the note at the bottom of
# that file about under-18 Workspace accounts before testing with a school
# account. It will save you a confusing afternoon.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Platform LLM tier (optional) ------------------------------------------
# Our own OpenAI key, funding the free tier (GPT-6 Luna).
#
# Leave BLANK to disable the free tier entirely -- students then have to bring
# their own key, which is a reasonable way to run before you want a bill.
PLATFORM_OPENAI_API_KEY=

# Per-student monthly token allowance. Defaults to 2,000,000 (~500 agent turns,
# roughly $0.40/student/month at Luna pricing) if unset.
PLATFORM_MONTHLY_TOKEN_QUOTA=
